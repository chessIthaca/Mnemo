    {
      "id": "fb3abbfb",
      "status": "closed",
      "created_at_ms": 1793859654396,
      "closed_at_ms": 1793860884916,
      "report_path": "C:\\Mnemo\\.coding\\reviews\\team-fb3abbfb-20261105-064124.md",
      "abandon_reason": null,
      "spec_deltas": [
        {
          "capability": "external-lead",
          "added": [
            {
              "requirement": "Tool calls attach the external lead",
              "text": "The system SHALL attach the external lead to a project's team on the first MCP tools/call for that project, and SHALL NOT attach it for initialize, tools/list, ping or a notices read.",
              "scenarios": [
                {
                  "name": "Opening Claude Code",
                  "when": [
                    "Claude Code starts in a registered project and lists the Mnemo tools"
                  ],
                  "then": [
                    "the in-app lead keeps receiving worker notices"
                  ],
                  "and": []
                },
                {
                  "name": "First tool call",
                  "when": [
                    "a helper forwards a tools/call for the project"
                  ],
                  "then": [
                    "the external lead is attached and worker notices queue for it"
                  ],
                  "and": []
                }
              ]
            },
            {
              "requirement": "A closing helper keeps the lead while another helper led",
              "text": "The system SHALL remember every helper id that made a tools/call while the external lead is attached, and a helper's detach on close SHALL release the lead only when no other remembered helper remains. A detach that names no helper SHALL release the lead.",
              "scenarios": [
                {
                  "name": "Second helper closes",
                  "when": [
                    "helpers a and b both made tool calls",
                    "helper b closes"
                  ],
                  "then": [
                    "the external lead stays attached and its waiter keeps waiting"
                  ],
                  "and": []
                },
                {
                  "name": "Last helper closes",
                  "when": [
                    "helper a is the only remembered helper",
                    "helper a closes"
                  ],
                  "then": [
                    "the external lead is released",
                    "unread notices go to the in-app lead"
                  ],
                  "and": []
                },
                {
                  "name": "Anonymous detach",
                  "when": [
                    "a detach arrives without a helper id"
                  ],
                  "then": [
                    "the external lead is released"
                  ],
                  "and": []
                }
              ]
            },
            {
              "requirement": "Idle external leads are released",
              "text": "The system SHALL release an external lead that made no Mnemo call for 10 minutes while no waiter runs, regardless of remembered helpers, and SHALL forget every remembered helper on any release.",
              "scenarios": [
                {
                  "name": "Crashed helper",
                  "when": [
                    "the only leading helper crashed without detaching",
                    "10 minutes pass with no call and no waiter"
                  ],
                  "then": [
                    "the external lead is released"
                  ],
                  "and": []
                }
              ]
            }
          ],
          "modified": [],
          "removed": [],
          "renamed": []
        }
      ],
      "schema": "spec-driven@1",
      "sections": {}
    },
    {
      "id": "3d329719",
      "status": "closed",
      "created_at_ms": 1793860095275,
      "closed_at_ms": 1793863513081,
      "report_path": "C:\\Mnemo\\.coding\\reviews\\team-3d329719-20261105-072513.md",
      "abandon_reason": null,
      "spec_deltas": [
        {
          "capability": "worker-brief",
          "added": [
            {
              "requirement": "Workers get the whole plan at dispatch",
              "text": "The system SHALL give every implementation worker, at dispatch, its plan's title, goal, kind, context, decisions, interfaces, acceptance scenarios, spec changes, schema sections, the step list and the full text of its own step, followed by the lead's brief, and SHALL NOT include the plan's progress notes.",
              "scenarios": [
                {
                  "name": "Dispatch header",
                  "when": [
                    "the lead dispatches a worker on step 2 of a plan with a decision and a spec change"
                  ],
                  "then": [
                    "the worker's instructions contain the decision, the spec change and step 2's full text before the brief"
                  ],
                  "and": [
                    "they contain no progress note"
                  ]
                }
              ]
            },
            {
              "requirement": "Workers can re-read their plan",
              "text": "The system SHALL offer workers a read-only plan_read tool that returns their own plan as it stands now, or with a capability name that capability's current OpenSpec spec, and every dispatch header SHALL say so. plan_read SHALL never return another plan.",
              "scenarios": [
                {
                  "name": "Decision after dispatch",
                  "when": [
                    "the lead records a decision after a worker started",
                    "the worker calls plan_read"
                  ],
                  "then": [
                    "the result contains the new decision"
                  ],
                  "and": []
                },
                {
                  "name": "Current spec",
                  "when": [
                    "a worker calls plan_read with capability tier-ladder"
                  ],
                  "then": [
                    "the result is the current tier-ladder spec"
                  ],
                  "and": []
                }
              ]
            },
            {
              "requirement": "Working workers hear about plan changes",
              "text": "The system SHALL send each worker that is working on a plan a short notice naming what changed when the plan's context, decisions, interfaces, steps, acceptance scenarios, spec changes or sections change, and SHALL NOT notify idle, completed, in-review or merged workers or notify on progress notes.",
              "scenarios": [
                {
                  "name": "Decision recorded",
                  "when": [
                    "a worker is working on a plan",
                    "the lead records a decision on it"
                  ],
                  "then": [
                    "the worker receives 'Plan <id> changed: new decision. Call plan_read to re-read it before you continue.'"
                  ],
                  "and": []
                },
                {
                  "name": "Worker awaiting review",
                  "when": [
                    "a worker finished its turn and awaits review",
                    "the lead records a decision"
                  ],
                  "then": [
                    "the worker receives nothing"
                  ],
                  "and": []
                }
              ]
            }
          ],
          "modified": [],
          "removed": [],
          "renamed": []
        }
      ],
      "schema": "spec-driven@1",
      "sections": {}
    },
