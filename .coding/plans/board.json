      "report_path": "C:\\Mnemo\\.coding\\reviews\\team-b5d961b5-20261105-055137.md",
      "abandon_reason": null,
      "spec_deltas": [
        {
          "capability": "tier-ladder",
          "added": [],
          "modified": [
            {
              "requirement": "Five fixed tiers",
              "text": "The system SHALL keep exactly five tiers in fixed order: trivial, routine, medium, high and escalate, each with an id, a name, a definition, an ordered model list and an optional reasoning effort. Escalate SHALL never be offered to Laya or the kNN overlay as a routing answer, and the lead's team_dispatch SHALL refuse it for fresh work; team_resume and team_route_fix MAY move an existing worker to it.",
              "scenarios": [
                {
                  "name": "Routing never picks escalate",
                  "when": [
                    "routing mode is auto and Laya classifies a dispatch"
                  ],
                  "then": [
                    "the chosen tier is one of trivial, routine, medium or high"
                  ],
                  "and": []
                },
                {
                  "name": "Lead picks escalate for fresh work",
                  "when": [
                    "the lead calls team_dispatch with tier escalate"
                  ],
                  "then": [
                    "the dispatch is refused as escalation only, never a first pick",
                    "no worker is provisioned"
                  ],
                  "and": []
                },
                {
                  "name": "Escalating an existing worker",
                  "when": [
                    "the lead calls team_resume on an idle worker with tier escalate"
                  ],
                  "then": [
                    "the worker restarts on the escalate tier, folding down when it has no model"
                  ],
                  "and": []
                }
              ]
            }
          ],
          "removed": [],
          "renamed": []
        }
      ],
      "schema": "spec-driven@1",
      "sections": {}
    },
