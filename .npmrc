audit=false
fund=false
# Pin to the public npm registry. This repo has no Autodesk-private deps, so it
# must not inherit the user's ~/.npmrc registry (npm.autodesk.com), which is
# unreachable off the corporate VPN and made `npm install` in start.bat fail
# with ENOTFOUND / "Exit handler never called!".
registry=https://registry.npmjs.org/
