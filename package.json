{
  "name": "mnemo",
  "private": true,
  "license": "MIT",
  "version": "2.1.0",
  "workspaces": [
    "frontend",
    "mnemo2"
  ],
  "scripts": {
    "start": "node scripts/start.mjs",
    "dev": "npm run dev --workspace frontend",
    "build": "npm run build --workspace frontend",
    "dev:mnemo2": "npm run dev --workspace mnemo2",
    "build:mnemo2": "npm run build --workspace mnemo2",
    "dev:mnemo2:native": "cargo run -p mnemo2-app --bin mnemo2",
    "build:mnemo2:native": "npm run build:mnemo2 && cargo build -p mnemo2-app --features custom-protocol --bins --release && node scripts/install-mnemo2-mcp.mjs",
    "bundle:mnemo2": "npm run build:mnemo2 && cd src-tauri/mnemo2-app && npx tauri build",
    "rebuild:mnemo2": "node scripts/rebuild-mnemo2.mjs",
    "test:mnemo2": "npm test --workspace mnemo2",
    "test:mnemo2:native": "cargo test --manifest-path src-tauri/Cargo.toml -p mnemo-app --features mnemo2 --lib",
    "check:mnemo2": "npm run check --workspace mnemo2"
  },
  "allowScripts": {
    "esbuild": true
  },
  "overrides": {
    "postcss-selector-parser": "^6.1.5"
  }
}
