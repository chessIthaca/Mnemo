{
  "name": "mnemo",
  "private": true,
  "license": "MIT",
  "version": "1.3.0",
  "workspaces": [
    "frontend",
    "mnemo2"
  ],
  "scripts": {
    "start": "node scripts/start.mjs",
    "dev": "npm run dev --workspace frontend",
    "build": "npm run build --workspace frontend",
    "dev:mnemo2": "npm run dev --workspace mnemo2",
    "build:mnemo2": "npm run build --workspace mnemo2",
    "dev:mnemo2:native": "cargo run --manifest-path src-tauri/Cargo.toml --bin mnemo2",
    "build:mnemo2:native": "npm run build:mnemo2 && cargo build --manifest-path src-tauri/Cargo.toml --bin mnemo2 --features custom-protocol --release",
    "test:mnemo2": "npm test --workspace mnemo2",
    "check:mnemo2": "npm run check --workspace mnemo2"
  },
  "allowScripts": {
    "esbuild": true
  }
}
